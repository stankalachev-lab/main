# Base64-encoded JSON arrays of CRMAccountConfig objects.
# Generate with: echo '[{...}]' | base64
KOMMO_ACCOUNTS=
AMO_ACCOUNTS=

# Static exchange rates relative to RUB base (for cross-account aggregation).
# Example: {"USD": 90.5, "EUR": 98.2}
EXCHANGE_RATES=

# In-memory cache TTL in seconds (default: 900 = 15 minutes)
CACHE_TTL_SECONDS=900

# API requests per second per CRM account (default: 5)
RATE_LIMIT_RPS=5

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
