{
  "name": "elevenlabs-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the ElevenLabs API: text to speech, speech to text, voice changer, sound effects, music, voice design and voice management.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "elevenlabs-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elevenlabs",
    "text-to-speech",
    "speech-to-text"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
